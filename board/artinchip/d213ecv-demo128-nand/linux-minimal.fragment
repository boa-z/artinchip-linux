# SPDX-License-Identifier: MIT
# Retain the reference SoC/NAND boot path, omit unrelated graphics and radio work.
# CONFIG_ARTINCHIP_GE is not set
# CONFIG_ARTINCHIP_VE is not set
# CONFIG_ARTINCHIP_FB is not set
# CONFIG_SND is not set
# CONFIG_BT is not set
# CONFIG_WLAN is not set
CONFIG_UBIFS_FS=y
CONFIG_MTD_UBI=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_8250_CONSOLE=y
